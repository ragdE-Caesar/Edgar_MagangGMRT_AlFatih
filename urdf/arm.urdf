<?xml version="1.0"?>
<robot name="intern_arm">
    <link name="base_link">
        <visual>
            <geometry>
                <cylinder radius="0.2" length="0.1"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name="hijau">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
    </link>

    <link name="base2">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="2"/>
            </geometry>
        </visual>
    </link>

    <link name="base3">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="1.5"/>
            </geometry>
            <origin xyz="0 0 0.75" rpy="0 0 0"/>
            <material name="merah">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
    </link>

    <link name="base4">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="1"/>
            </geometry>
            <origin xyz="-0.5 0 0.5" rpy="0 0 0"/>
            <material name="merah">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
    </link>

    <joint name="base_to_base2" type="continuous">
        <parent link="base_link"/>
        <child link="base2"/>
        <origin xyz="0 0 1.1" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="base2_to_base3" type="revolute">
        <parent link="base2"/>
        <child link="base3"/>
        <origin xyz="0 0 1" rpy="0 1.57 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="0" effort="50.0" velocity="2.0"/>
    </joint>

    <joint name="base3_to_base4" type="revolute">
        <parent link="base3"/>
        <child link="base4"/>
        <origin xyz="0 0 1" rpy="0 1.57 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="0" effort="50.0" velocity="2.0"/>
    </joint>
</robot>