<?xml version="1.0"?>
<robot name="intern_arm">
    
    <link name="link_1">
        <visual>
            <geometry>
                <cylinder radius="0.2" length="0.1"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name="green">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
    </link>

    <link name="link_2">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="2"/>
            </geometry>

        </visual>
    </link>

    <link name="link_3">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="1.5"/>
            </geometry>
            <origin xyz="0 0 0.75" rpy="0 0 0"/>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
    </link>

    <link name="link_4">
        <visual name="gripper_base">
            <origin xyz="0.15 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.3 0.12 0.08"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <visual name="left_finger">
            <origin xyz="0.32 0.05 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.02 0.16"/>
            </geometry>
        </visual>
        <visual name="right_finger">
            <origin xyz="0.32 -0.05 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.02 0.16"/>
            </geometry>
        </visual>
    </link>

    <joint name="joint_1" type="continuous">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 0 1.1" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="joint_2" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0 0 1" rpy="0 1.57 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="0" effort="50.0" velocity="2.0"/>
    </joint>

    <joint name="joint_3" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0 0 1.5" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="0" effort="50.0" velocity="2.0"/>
    </joint>
</robot>